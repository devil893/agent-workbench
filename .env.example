# Environment variables are read by the application; load this file in your shell.
WORKBENCH_BACKEND=demo
WORKBENCH_DB=data/workbench.sqlite3
# Map each secret bearer token to a tenant. Generate your own long random tokens.
WORKBENCH_TOKENS={"replace-with-a-random-secret":"demo-user"}
# Optional real model; external tools remain simulated in both backends.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional inbound Twilio channel. Both values are required to enable it.
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
# JSON list of allowed E.164 phone numbers. Empty means nobody is allowed.
TWILIO_ALLOWED_PHONES=[]

